# Copy this file to .env.development and .env.production and modify accordingly

# Development Environment Configuration
# NODE_ENV=development
# PORT=9011

# Production Environment Configuration  
# NODE_ENV=production
# PORT=9011

# Database - PostgreSQL
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=submission_user
DB_PASSWORD=submission_password
DB_DATABASE=submission_db

# TypeORM
DB_SYNCHRONIZE=true
DB_LOGGING=true

# API Authentication
API_TOKEN=your_secret_token_here_change_in_production
