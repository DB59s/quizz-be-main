# Copy this file to .env.development and .env.production and modify accordingly

# Development Environment Configuration
# NODE_ENV=development
# PORT=3000

# Production Environment Configuration  
# NODE_ENV=production
# PORT=8000

# Database - MySQL (comment out PostgreSQL section below)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=base_be_dev

# Database - PostgreSQL (comment out MySQL section above)
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=password
# DB_DATABASE=base_be_dev

# TypeORM
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT Configuration for Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# API Gateway - Service Base URLs
USER_SERVICE_BASEURL=http://localhost:3001
PRODUCT_SERVICE_BASEURL=http://localhost:3002
ORDER_SERVICE_BASEURL=http://localhost:3003
NOTIFICATION_SERVICE_BASEURL=http://localhost:3004
